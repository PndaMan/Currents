# Pushes the App Store listing in ios/AppStore to App Store Connect.
#
# Authentication is an App Store Connect API key, read from the environment:
#   ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_PATH
#   (default ~/.appstoreconnect/private_keys/AuthKey_<ASC_KEY_ID>.p8)
#
# Nothing here submits for review. Run through make (appstore-metadata,
# appstore-screenshots), which also loads ASC_* from .env.local.

default_platform(:ios)
skip_docs
opt_out_usage

APP_IDENTIFIER = "com.aidanmcconnon.currents"
IOS_DIR = File.expand_path("..", __dir__)
REPO_DIR = File.expand_path("..", IOS_DIR)

platform :ios do
  # MARKETING_VERSION from project.yml. All targets must agree.
  private_lane :marketing_version do
    versions = File.read(File.join(IOS_DIR, "project.yml")).scan(/MARKETING_VERSION:\s*"?([0-9.]+)"?/).flatten.uniq
    UI.user_error!("MARKETING_VERSION not found in project.yml") if versions.empty?
    UI.user_error!("project.yml has more than one MARKETING_VERSION: #{versions.join(', ')}") if versions.count > 1
    versions.first
  end

  private_lane :asc_api_key do
    key_id = ENV["ASC_KEY_ID"].to_s
    issuer_id = ENV["ASC_ISSUER_ID"].to_s
    UI.user_error!("Set ASC_KEY_ID and ASC_ISSUER_ID (in the environment or .env.local)") if key_id.empty? || issuer_id.empty?
    key_path = ENV["ASC_KEY_PATH"].to_s
    key_path = "~/.appstoreconnect/private_keys/AuthKey_#{key_id}.p8" if key_path.empty?
    key_path = File.expand_path(key_path)
    UI.user_error!("API key file not found at ASC_KEY_PATH (#{key_path})") unless File.exist?(key_path)
    app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_filepath: key_path,
      duration: 1200,
      in_house: false
    )
  end

  desc "Read-only: check the API key and show the app's App Store versions"
  lane :check do
    asc_api_key
    app = Spaceship::ConnectAPI::App.find(APP_IDENTIFIER)
    UI.user_error!("No app with bundle id #{APP_IDENTIFIER}") unless app
    UI.message("#{app.name} (#{app.bundle_id}), project.yml version #{marketing_version}")
    app.get_app_store_versions(filter: { platform: "IOS" }, limit: 5).each do |v|
      UI.message("  #{v.version_string}: #{v.app_store_state}")
    end
  end

  desc "Upload name, subtitle, keywords, description, promotional text, release notes and URLs for en-US, en-GB and es-MX"
  lane :metadata do
    deliver(
      api_key: asc_api_key,
      app_identifier: APP_IDENTIFIER,
      platform: "ios",
      app_version: marketing_version,
      metadata_path: File.join(IOS_DIR, "AppStore", "metadata"),
      skip_binary_upload: true,
      skip_screenshots: true,
      force: true,
      submit_for_review: false,
      automatic_release: false,
      run_precheck_before_submit: false,
      precheck_include_in_app_purchases: false
    )
  end

  # Synced, not replaced: deliver compares each screenshot by locale, filename
  # and checksum, uploads only what differs, deletes what is no longer there
  # and sorts each set, so a second run with the same files changes nothing.
  desc "Sync the screenshots for en-US, en-GB and es-MX with the framed set and watch.png from the app-store-screenshots branch"
  lane :screenshots do
    script = File.join(REPO_DIR, "scripts", "appstore_screenshots.sh")
    screenshots_path = sh(script, log: false).lines.last.strip
    ENV["FASTLANE_ENABLE_BETA_DELIVER_SYNC_SCREENSHOTS"] = "1"
    deliver(
      api_key: asc_api_key,
      app_identifier: APP_IDENTIFIER,
      platform: "ios",
      app_version: marketing_version,
      screenshots_path: screenshots_path,
      skip_binary_upload: true,
      skip_metadata: true,
      sync_screenshots: true,
      force: true,
      submit_for_review: false,
      automatic_release: false,
      run_precheck_before_submit: false,
      precheck_include_in_app_purchases: false
    )
  end
end
