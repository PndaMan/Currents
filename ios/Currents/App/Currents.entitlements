<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Group re-enabled once provisioning exists (widgets/Live Activity).
	     Kept out of the archive until then so signing doesn't fail:
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.aidanmcconnon.currents</string>
	</array>
	-->
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.com.aidanmcconnon.currents</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudDocuments</string>
	</array>
	<key>com.apple.developer.ubiquity-container-identifiers</key>
	<array>
		<string>iCloud.com.aidanmcconnon.currents</string>
	</array>
	<key>com.apple.developer.ubiquity-kvstore-identifier</key>
	<string>$(TeamIdentifierPrefix)com.aidanmcconnon.currents</string>
</dict>
</plist>
