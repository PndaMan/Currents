DEFINE SCHEMA

    RECORD TYPE AnglerProfile (
        displayName     STRING,
        friendCode      STRING QUERYABLE,
        bio             STRING,
        homeWater       STRING,
        region          STRING QUERYABLE,
        memberSince     TIMESTAMP,
        totalCatches    INT64,
        speciesCount    INT64,
        bestWeightKg    DOUBLE,
        bestLengthCm    DOUBLE,
        favoriteSpecies STRING,
        avatar          ASSET,
        updatedAt       TIMESTAMP,
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE LeaderCatch (
        anglerName  STRING,
        friendCode  STRING QUERYABLE,
        species     STRING,
        weightKg    DOUBLE,
        lengthCm    DOUBLE,
        region      STRING QUERYABLE,
        caughtAt    TIMESTAMP,
        groupCode   STRING QUERYABLE,
        hasPhoto    INT64,
        photo       ASSET,
        lat         DOUBLE,
        lon         DOUBLE,
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE SharedSpot (
        ownerCode   STRING QUERYABLE,
        toCode      STRING QUERYABLE,
        name        STRING,
        type        STRING,
        notes       STRING,
        lat         DOUBLE,
        lon         DOUBLE,
        approx      INT64,
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE GroupTrip (
        code        STRING QUERYABLE,
        name        STRING,
        hostCode    STRING,
        hostName    STRING,
        createdAt   TIMESTAMP,
        -- Queryable so crew members get a push the moment a trip goes live.
        crewCode    STRING QUERYABLE,
        -- CRITICAL: endGroupTrip always wrote this, but production rejects
        -- writes to undeclared fields — so no trip ever actually ended.
        endedAt     TIMESTAMP,
        -- Set when this session is a team inside a crew tournament.
        tournamentCode STRING QUERYABLE,
        teamName    STRING,
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE GroupMember (
        groupCode   STRING QUERYABLE,
        -- Queryable so a reinstalled device can rebuild its trip list.
        memberCode  STRING QUERYABLE,
        memberName  STRING,
        joinedAt    TIMESTAMP,
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE GroupInvite (
        groupCode   STRING,
        tripName    STRING,
        fromCode    STRING,
        fromName    STRING,
        toCode      STRING QUERYABLE,
        createdAt   TIMESTAMP,
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        GRANT WRITE TO "_icloud",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE FriendRequest (
        fromCode    STRING QUERYABLE,
        fromName    STRING,
        toCode      STRING QUERYABLE,
        status      STRING QUERYABLE,
        createdAt   TIMESTAMP,
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        GRANT WRITE TO "_icloud",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CatchGrant (
        ownerCode   STRING QUERYABLE,
        viewerCode  STRING QUERYABLE,
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CodeClaim (
        claimedAt   TIMESTAMP,
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    -- A "Crew": a persistent circle of friends with a shared catch feed.
    -- WRITE is _icloud (not _creator) so Mates can edit identity and manage
    -- roles; the app enforces who may, by role.
    RECORD TYPE Crew (
        code          STRING QUERYABLE,
        name          STRING,
        emoji        STRING,
        createdByCode STRING,
        createdByName STRING,
        createdAt     TIMESTAMP,
        banner        ASSET,
        iconPhoto     ASSET,
        mates         STRING,
        admins        STRING,
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        GRANT WRITE TO "_icloud",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    -- One row per angler per crew. Queried by crewCode to list a crew's members.
    -- WRITE is _icloud so admins can remove members (app-enforced by role).
    RECORD TYPE CrewMember (
        crewCode    STRING QUERYABLE,
        -- Queryable so a reinstalled device can rebuild its crew list.
        memberCode  STRING QUERYABLE,
        memberName  STRING,
        joinedAt    TIMESTAMP,
        role        STRING,
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        GRANT WRITE TO "_icloud",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    -- A catch shared into a crew's feed. Queried by crewCode; caughtAt is
    -- sortable+queryable so the feed paginates instead of loading everything.
    -- WRITE is _icloud so admins can delete posts (app-enforced by role).
    RECORD TYPE CrewPost (
        crewCode    STRING QUERYABLE,
        authorCode  STRING,
        authorName  STRING,
        species     STRING,
        weightKg    DOUBLE,
        lengthCm    DOUBLE,
        caughtAt    TIMESTAMP QUERYABLE SORTABLE,
        caption     STRING,
        hasPhoto    INT64,
        photo       ASSET,
        tripName    STRING,
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        GRANT WRITE TO "_icloud",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    -- One reaction per angler per post. Queried by crewCode (grouped by postId
    -- on-device). postAuthorCode carries the post owner's friend code so a
    -- push subscription can target "reactions to MY posts" (CloudKit predicates
    -- cannot express joins or !=, so the fact is denormalised onto the record).
    RECORD TYPE CrewReaction (
        postId      STRING,
        crewCode    STRING QUERYABLE,
        postAuthorCode STRING QUERYABLE,
        reactorCode STRING,
        reactorName STRING,
        emoji       STRING,
        createdAt   TIMESTAMP,
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    -- A crew tournament: teams (live sessions with a team name) compete on
    -- points. Created by crew admins; winner declared by an admin at the end.
    RECORD TYPE Tournament (
        code        STRING QUERYABLE,
        crewCode    STRING QUERYABLE,
        name        STRING,
        hostCode    STRING,
        hostName    STRING,
        createdAt   TIMESTAMP,
        endsAt      TIMESTAMP,
        endedAt     TIMESTAMP,
        winnerTeam  STRING,
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        GRANT WRITE TO "_icloud",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );
