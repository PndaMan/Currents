*.pyc
.venv/
*.egg-info/

# Environment
.env
.env.local
*.pem
*.p8
*.p12
*.cer
*.mobileprovision

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp

